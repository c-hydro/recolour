  "datasets": {
    "reference": {
      "name": "hmc_vtotal",
      "role": "reference",

      "type": "netcdf_hmc_state",
      "compression": true,
      "compression_type": "gzip",

      "folder": "/home/fabio/Desktop/recolour/dset/metrics/data/model_hmc/{time:%Y/%m/}",
      "filename": "hmc.state-grid.{time:%Y%m%d%H%M}.nc.gz",

      "variable": "VTot",
      "longitude": "Longitude",  "latitude": "Latitude",
      "crs": "EPSG:4326",

      "engine": "h5netcdf",

      "scale_factor": 1.0, "offset": 0.0,
      "valid_min": 0.0, "valid_max": null,
      "nodata_values": [-9999.0, -9e15],

      "compression_settings": {"temporary_folder": "/tmp/sm_grid_metrics"},

      "scaling": {"enabled": true, "minimum_v": 0.001, "clip_min": 0.0, "clip_max": 1.0}
    },

    "other": {
      "name": "external_soil_moisture",
      "role": "candidate",

      "type": "tiff",
      "compression": false,

      "folder": "/home/fabio/Desktop/recolour/dset/metrics/data/model_cnr/{time:%Y/%m/%d}",
      "filename": "soil_moisture_{time:%Y%m%d%H}.tif",

      "band": 1, "crs": "EPSG:4326",
      "scale_factor": 1.0, "offset": 0.0,
      "valid_min": 0.0, "valid_max": 1.0,
      "nodata_values": [-9999.0],

      "scaling": {}
    }
  },

  "metrics": {
    "__comment__": "seasons tags:  ALL, DJF, MAM, JJA, SON; aggregation_type: season, month; aggregation_by: name, month_start, month_end",
    "seasons": ["ALL", "DJF", "MAM", "JJA", "SON"],
    "min_observations": 5,
    "dtype": "float64",
    "continue_on_error": true,
    "threshold_percentage": 15.0,
    "aggregation_type": "season", "aggregation_by": "end_month"
  },

  "weights": {
    "method": "correlation_error",
    "maximum_weight": 0.8,
    "correlation": {"minimum": 0.3, "power": 1.0},
    "error": {"power": 2.0, "minimum_std": 0.01},
    "observations": {"minimum": 5, "target": 6}
  },

  "img": {
    "enabled": true,

    "folder": "/home/fabio/Desktop/recolour/exec/metrics/images/",
    "filename": "sm_weights_{name}_{season}.png",

    "layers": [
      "weight",
      "weight_correlation",
      "weight_error",
      "weight_observations",
      "normalized_error"
    ],

    "dpi": 150,
    "figsize": [10, 8],
    "colormap": "viridis",

    "title": "Soil moisture nudging weight: {name}",
    "colorbar_label": "Weight",

    "show_colorbar": true, "show_axis": true, "grid": false,
    "transpose": false, "flip_vertical": false,
    "vmin": null, "vmax": null,

    "ranges": {
      "weight": {"vmin": 0.0, "vmax": 1.0},
      "weight_correlation": {"vmin": 0.0, "vmax": 1.0},
      "weight_error": {"vmin": 0.0, "vmax": 1.0},
